<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>電子クーポンアプリ</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <!-- 追加: Leaflet CSS (完全無料の地図ライブラリ) -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700;900&display=swap');
        body { font-family: 'Noto Sans JP', sans-serif; -webkit-tap-highlight-color: transparent; }
        .modal-enter { animation: slideUp 0.3s ease-out; }
        @keyframes slideUp { from { transform: translateY(100%); } to { transform: translateY(0); } }
        .safe-area-bottom { padding-bottom: env(safe-area-inset-bottom); }


        /* 背景アニメーション用のキーフレーム */
        @keyframes blob {
            0% { transform: translate(0px, 0px) scale(1); }
            33% { transform: translate(30px, -50px) scale(1.1); }
            66% { transform: translate(-20px, 20px) scale(0.9); }
            100% { transform: translate(0px, 0px) scale(1); }
        }
        .animate-blob { animation: blob 7s infinite; }
        .animation-delay-2000 { animation-delay: 2s; }
        .animation-delay-4000 { animation-delay: 4s; }


        /* Leaflet Popup カスタマイズ */
        .leaflet-popup-content-wrapper { border-radius: 1rem; box-shadow: 0 10px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1); border: 1px solid #f1f5f9; }
        .leaflet-popup-content { margin: 12px; font-family: 'Noto Sans JP', sans-serif; }
        .leaflet-popup-tip { box-shadow: 0 10px 25px -5px rgb(0 0 0 / 0.1); }
    </style>
</head>
<body class="bg-indigo-50 text-slate-900 overflow-hidden">


    <!-- 背景の装飾 (ふわふわ動くグラデーション円) -->
    <div class="fixed inset-0 w-full h-full overflow-hidden pointer-events-none z-0 flex justify-center bg-gradient-to-br from-purple-100 via-pink-50 to-indigo-100">
        <div class="relative w-full max-w-md h-full">
            <div class="absolute top-[0%] left-[-10%] w-80 h-80 bg-purple-400 rounded-full mix-blend-multiply filter blur-2xl opacity-80 animate-blob"></div>
            <div class="absolute top-[25%] right-[-10%] w-80 h-80 bg-pink-400 rounded-full mix-blend-multiply filter blur-2xl opacity-80 animate-blob animation-delay-2000"></div>
            <div class="absolute bottom-[10%] left-[10%] w-80 h-80 bg-yellow-300 rounded-full mix-blend-multiply filter blur-2xl opacity-80 animate-blob animation-delay-4000"></div>
        </div>
    </div>


    <!-- アプリコンテナ (すりガラス効果) -->
    <div id="app" class="flex flex-col h-screen max-w-md mx-auto bg-white/40 backdrop-blur-2xl shadow-2xl relative z-10 border-x border-white/40">
        <!-- Header -->
        <header class="px-6 pt-8 pb-4 border-b border-white/50 shrink-0 bg-white/60 backdrop-blur-md z-20">
            <div class="flex justify-between items-center">
                <div>
                    <h1 class="text-2xl font-black tracking-tighter text-indigo-600">電子クーポン</h1>
                    <p class="text-[10px] font-bold text-slate-500 uppercase tracking-widest leading-none mt-1">高校生地域活性化プロジェクト</p>
                </div>
                <div id="no-data-alert" class="hidden animate-pulse bg-amber-100 p-2 rounded-full text-amber-600">
                    <i class="fas fa-exclamation-triangle text-xs"></i>
                </div>
            </div>
        </header>


        <!-- Main Content -->
        <main class="flex-1 overflow-hidden relative flex flex-col bg-transparent">
            <!-- 通常のタブコンテンツ -->
            <div id="dynamic-content" class="flex-1 overflow-y-auto p-5 pb-24">
                <!-- Content will be injected here -->
            </div>
           
            <!-- マップ用コンテンツ (完全無料のLeafletを使用) -->
            <div id="map-wrapper" class="absolute inset-0 pb-[72px] hidden z-10 bg-slate-200">
                <div id="map-container" class="w-full h-full"></div>
            </div>
        </main>


        <!-- Navigation -->
        <nav class="fixed bottom-0 left-0 right-0 max-w-md mx-auto bg-white/70 backdrop-blur-xl border-t border-white/50 px-2 py-4 flex justify-around items-center z-50 safe-area-bottom">
            <button onclick="switchTab('coupons')" id="nav-coupons" class="flex flex-col items-center gap-1 text-indigo-600 transition-colors w-1/4">
                <i class="fas fa-ticket-alt text-lg"></i>
                <span class="text-[10px] font-bold">クーポン</span>
            </button>
            <button onclick="switchTab('stores')" id="nav-stores" class="flex flex-col items-center gap-1 text-slate-400 transition-colors w-1/4">
                <i class="fas fa-store text-lg"></i>
                <span class="text-[10px] font-bold">店舗</span>
            </button>
            <button onclick="switchTab('map')" id="nav-map" class="flex flex-col items-center gap-1 text-slate-400 transition-colors w-1/4">
                <i class="fas fa-map-marker-alt text-lg"></i>
                <span class="text-[10px] font-bold">マップ</span>
            </button>
            <button onclick="switchTab('account')" id="nav-account" class="flex flex-col items-center gap-1 text-slate-400 transition-colors w-1/4">
                <i class="fas fa-user text-lg"></i>
                <span class="text-[10px] font-bold">アカウント</span>
            </button>
        </nav>


        <!-- Coupon Modal -->
        <div id="modal-overlay" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-[100] hidden flex items-end justify-center">
            <div id="modal-content" class="bg-white w-full max-w-md rounded-t-[2.5rem] p-8 shadow-2xl modal-enter relative">
                <div id="modal-body">
                    <!-- Modal content injected here -->
                </div>
            </div>
        </div>
    </div>


    <!-- 追加: Leaflet JS -->
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>


    <script>
        // Data Keys
        const KEYS = {
            STORES: 'hs_project_stores',
            COUPONS: 'hs_project_coupons',
            LOGS: 'hs_project_logs',
            TRIGGER: 'hs_project_sync_trigger'
        };


        let currentTab = 'coupons';
        let stores = [];
        let coupons = [];
        let logs = [];
        let selectedCoupon = null;
        let useStep = 1;
        let spendAmount = '';


        // マップ用変数
        let map = null;
        let markersLayer = null;


        // ユーザー情報 (ダミー)
        let userProfile = {
            name: '都城 太郎',
            id: 'USER-987654321',
            memberSince: '2026/04/01',
            basePoint: 500
        };


        // Initialize
        function init() {
            loadData();
            initMap();
            render();
           
            // Sync with other tabs
            window.addEventListener('storage', (e) => {
                if (Object.values(KEYS).includes(e.key)) {
                    loadData();
                    if (currentTab !== 'map') render();
                }
            });


            // Polling fallback
            setInterval(() => {
                loadData();
                if (currentTab !== 'map') render();
            }, 3000);
        }


        // --- 地図関連の処理 (完全無料のオープンソースを使用) ---
        function initMap() {
            // 都城市を中心に設定
            map = L.map('map-container', { zoomControl: false }).setView([31.7183, 131.0615], 14);
            L.control.zoom({ position: 'topright' }).addTo(map);


            // アクセスブロックを回避し、無料で使える国土地理院のタイルを使用
            L.tileLayer('https://cyberjapandata.gsi.go.jp/xyz/std/{z}/{x}/{y}.png', {
                maxZoom: 18,
                minZoom: 9, // ズームアウトを制限
                attribution: '<a href="https://maps.gsi.go.jp/development/ichiran.html" target="_blank">国土地理院</a>'
            }).addTo(map);


            // 宮崎県周辺に表示領域を制限
            const miyazakiBounds = L.latLngBounds(
                [31.3000, 130.6000],
                [32.9000, 132.0000]
            );
            map.setMaxBounds(miyazakiBounds);
            map.on('drag', function() {
                map.panInsideBounds(miyazakiBounds, { animate: false });
            });


            markersLayer = L.layerGroup().addTo(map);
            updateMapMarkers();
        }


        function updateMapMarkers() {
            if (!map || !markersLayer) return;
            markersLayer.clearLayers();


            const customIcon = L.divIcon({
                html: '<div class="w-10 h-10 bg-indigo-600 text-white rounded-full flex items-center justify-center shadow-[0_0_15px_rgba(79,70,229,0.5)] border-2 border-white -translate-y-2"><i class="fas fa-store text-sm"></i></div>',
                className: '',
                iconSize: [40, 40],
                iconAnchor: [20, 20],
                popupAnchor: [0, -20]
            });


            stores.forEach(s => {
                if (s.lat && s.lng) {
                    const marker = L.marker([s.lat, s.lng], { icon: customIcon });
                   
                    marker.bindPopup(`
                        <div class="text-center p-2 min-w-[120px]">
                            <div class="w-12 h-12 bg-slate-50 rounded-full flex items-center justify-center text-xl mx-auto mb-2 border border-slate-100">
                                ${s.icon || '🏪'}
                            </div>
                            <strong class="block text-sm font-bold text-slate-800 mb-1 leading-tight">${s.name}</strong>
                            <span class="inline-block text-[10px] font-bold text-indigo-600 bg-indigo-50 px-2 py-1 rounded-full">${s.category}</span>
                        </div>
                    `);
                    // 検索用に店舗名をプロパティに持たせる
                    marker.storeName = s.name;
                    markersLayer.addLayer(marker);
                }
            });
        }


        // 「マップで見る」を押したときの挙動
        function showStoreOnMap(storeName) {
            switchTab('map'); // マップタブに切り替え
           
            // 少し待ってマップの描画が完了してから、該当のピンを開く
            setTimeout(() => {
                if (map && markersLayer) {
                    let targetMarker = null;
                    markersLayer.eachLayer(layer => {
                        if (layer.storeName === storeName) {
                            targetMarker = layer;
                        }
                    });
                   
                    if (targetMarker) {
                        map.setView(targetMarker.getLatLng(), 16);
                        targetMarker.openPopup();
                    }
                }
            }, 100);
        }


        function loadData() {
            stores = JSON.parse(localStorage.getItem(KEYS.STORES)) || [];
            coupons = JSON.parse(localStorage.getItem(KEYS.COUPONS)) || [];
            logs = JSON.parse(localStorage.getItem(KEYS.LOGS)) || [];
           
            // --- ダミーデータの注入 (データが空の場合のみ) ---
            if (stores.length === 0) {
                stores = [
                    { id: 'store1', name: '都城ミート', category: '精肉店', icon: '🥩', pin: '1234', lat: 31.7193, lng: 131.0625 },
                    { id: 'store2', name: 'カフェ・サクラ', category: '飲食店', icon: '☕', pin: '1234', lat: 31.7173, lng: 131.0605 },
                    { id: 'store3', name: 'フレッシュ青果', category: '八百屋', icon: '🥬', pin: '1234', lat: 31.7180, lng: 131.0630 }
                ];
                localStorage.setItem(KEYS.STORES, JSON.stringify(stores));
            }


            if (coupons.length === 0) {
                coupons = [
                    { id: 'c1', storeId: 'store1', storeName: '都城ミート', title: '宮崎牛・黒豚 全品10%OFF', desc: 'お会計時に10%割引になります。他サービスとの併用不可。', expiry: '2026/05/31' },
                    { id: 'c2', storeId: 'store2', storeName: 'カフェ・サクラ', title: 'セットドリンク1杯無料', desc: 'お食事をご注文の方に限り、コーヒーまたは紅茶を1杯無料でご提供いたします。', expiry: '2026/05/15' },
                    { id: 'c3', storeId: 'store3', storeName: 'フレッシュ青果', title: '地元野菜詰め合わせ 100円引', desc: '指定の地元野菜詰め合わせセットがレジにて100円引きになります。', expiry: '2026/05/31' }
                ];
                localStorage.setItem(KEYS.COUPONS, JSON.stringify(coupons));
            }


            // 位置情報がない店舗にダミーの座標を付与（都城市役所周辺）
            stores.forEach((s) => {
                if (!s.lat || !s.lng) {
                    const baseLat = 31.7183;
                    const baseLng = 131.0615;
                    s.lat = baseLat + (Math.random() - 0.5) * 0.02;
                    s.lng = baseLng + (Math.random() - 0.5) * 0.02;
                }
            });


            const alertIcon = document.getElementById('no-data-alert');
            if (stores.length === 0) alertIcon.classList.remove('hidden');
            else alertIcon.classList.add('hidden');


            if (map) updateMapMarkers();
        }


        function switchTab(tab) {
            currentTab = tab;
           
            // Update Nav UI
            ['coupons', 'stores', 'map', 'account'].forEach(t => {
                const nav = document.getElementById(`nav-${t}`);
                if (t === tab) {
                    nav.classList.add('text-indigo-600');
                    nav.classList.remove('text-slate-400');
                } else {
                    nav.classList.remove('text-indigo-600');
                    nav.classList.add('text-slate-400');
                }
            });


            const dynamicContent = document.getElementById('dynamic-content');
            const mapWrapper = document.getElementById('map-wrapper');


            // マップタブの表示切替
            if (tab === 'map') {
                dynamicContent.classList.add('hidden');
                mapWrapper.classList.remove('hidden');
               
                // Leafletにコンテナサイズが変わったことを伝えて再描画させる
                if (map) {
                    setTimeout(() => {
                        map.invalidateSize();
                        // 店舗があればすべてのマーカーが収まるようにズーム調整
                        if (stores.length > 0 && markersLayer.getLayers().length > 0) {
                            const group = new L.featureGroup(markersLayer.getLayers());
                            map.fitBounds(group.getBounds(), { padding: [30, 30], maxZoom: 16 });
                        }
                    }, 10);
                }
            } else {
                dynamicContent.classList.remove('hidden');
                mapWrapper.classList.add('hidden');
                render();
            }
        }


        function render() {
            if (currentTab === 'map') return; // マップ表示時はDOM操作をスキップ


            const container = document.getElementById('dynamic-content');
            let html = '';


            if (currentTab === 'coupons') {
                html = `<div class="space-y-4">
                    <div class="flex justify-between items-center mb-2">
                        <h2 class="font-bold text-lg">利用可能なクーポン</h2>
                        <span class="bg-indigo-100 text-indigo-600 text-[10px] px-2 py-1 rounded-full font-bold">${coupons.length}件</span>
                    </div>`;
               
                if (coupons.length > 0) {
                    coupons.forEach(c => {
                        html += `
                        <div onclick="openCoupon('${c.id}')" class="bg-white/80 backdrop-blur-sm rounded-2xl p-5 shadow-sm border border-white active:scale-95 transition-all cursor-pointer relative overflow-hidden">
                            <div class="flex justify-between items-start mb-3">
                                <div class="space-y-0.5">
                                    <p class="text-[10px] font-bold text-slate-500 uppercase tracking-wide">${c.storeName}</p>
                                    <h3 class="font-bold text-slate-800 leading-tight">${c.title}</h3>
                                </div>
                                <i class="fas fa-chevron-right text-slate-300 text-sm mt-1"></i>
                            </div>
                            <div class="flex justify-between items-end mt-2">
                                <span class="text-[10px] font-medium text-slate-500"><i class="far fa-clock mr-1"></i>有効期限: ${c.expiry}</span>
                            </div>
                        </div>`;
                    });
                } else {
                    html += `
                    <div class="text-center py-20 bg-white/60 backdrop-blur-sm rounded-2xl border border-white shadow-sm mt-4">
                        <div class="w-16 h-16 bg-white/50 rounded-full flex items-center justify-center mx-auto mb-4">
                            <i class="fas fa-ticket-alt text-slate-300 text-2xl block"></i>
                        </div>
                        <p class="text-sm text-slate-600 font-bold">現在発行されている<br>クーポンはありません</p>
                    </div>`;
                }
                html += '</div>';
            } else if (currentTab === 'stores') {
                html = `<div class="flex justify-between items-center mb-4">
                            <h2 class="font-bold text-lg">参加店舗一覧</h2>
                            <span class="text-xs font-bold text-slate-500">${stores.length}店舗</span>
                        </div>`;
                if (stores.length > 0) {
                    html += `<div class="grid grid-cols-2 gap-4">`;
                    stores.forEach(s => {
                        html += `
                        <div class="bg-white/80 backdrop-blur-sm p-5 rounded-2xl shadow-sm border border-white text-center flex flex-col items-center justify-center aspect-square relative overflow-hidden">
                            <div class="w-12 h-12 bg-indigo-50/50 rounded-full flex items-center justify-center text-xl mx-auto mb-2 shadow-inner border border-white/50">
                                ${s.icon || '🏪'}
                            </div>
                            <h3 class="font-bold text-xs text-slate-800 w-full truncate px-1">${s.name}</h3>
                            <p class="text-[9px] font-bold text-slate-500 mt-1 uppercase tracking-wider mb-2">${s.category}</p>
                           
                            <!-- Leafletマップで該当のピンを開くボタン -->
                            <button onclick="showStoreOnMap('${s.name}')" class="text-[9px] font-bold text-indigo-600 bg-white hover:bg-indigo-50 px-3 py-1.5 rounded-full transition-colors active:scale-95 flex items-center gap-1 border border-indigo-100 shadow-sm">
                                <i class="fas fa-map-marker-alt"></i> マップで見る
                            </button>
                        </div>`;
                    });
                    html += `</div>`;
                } else {
                    html += `<div class="text-center py-20 text-slate-500 text-sm font-bold bg-white/60 backdrop-blur-sm rounded-2xl shadow-sm border border-white mt-4">店舗が登録されていません</div>`;
                }
            } else if (currentTab === 'account') {
                // 履歴から合計利用額とポイントを計算
                const totalSpend = logs.reduce((sum, log) => sum + log.spend, 0);
                const earnedPoints = Math.floor(totalSpend * 0.01);
                const currentPoints = userProfile.basePoint + earnedPoints;


                html = `
                <div class="space-y-6">
                    <h2 class="font-bold text-lg mb-2">マイページ</h2>
                   
                    <!-- ユーザー情報カード -->
                    <div class="bg-gradient-to-br from-indigo-500 to-purple-600 rounded-3xl p-6 text-white shadow-lg relative overflow-hidden">
                        <div class="absolute top-0 right-0 w-32 h-32 bg-white/10 rounded-full -mr-10 -mt-10 blur-xl"></div>
                        <div class="flex items-center gap-4 relative z-10">
                            <div class="w-16 h-16 bg-white/20 rounded-full border-2 border-white/50 flex items-center justify-center text-2xl backdrop-blur-sm shadow-inner">
                                👤
                            </div>
                            <div>
                                <p class="text-xs font-medium text-indigo-100 mb-0.5">一般会員</p>
                                <h3 class="text-xl font-black tracking-tight">${userProfile.name}</h3>
                                <p class="text-[10px] text-indigo-200 mt-1 font-mono">${userProfile.id}</p>
                            </div>
                        </div>
                        <div class="mt-6 bg-white/10 rounded-2xl p-4 backdrop-blur-md border border-white/20 flex justify-between items-center relative z-10">
                            <div>
                                <p class="text-[10px] font-bold text-indigo-100 mb-1">保有ポイント</p>
                                <div class="flex items-baseline gap-1">
                                    <span class="text-2xl font-black">${currentPoints.toLocaleString()}</span>
                                    <span class="text-xs font-bold">pt</span>
                                </div>
                            </div>
                            <div class="text-right">
                                <p class="text-[10px] font-bold text-indigo-100 mb-1">累計利用額</p>
                                <p class="text-sm font-bold">¥${totalSpend.toLocaleString()}</p>
                            </div>
                        </div>
                    </div>


                    <!-- メニューリスト -->
                    <div class="bg-white/80 backdrop-blur-sm rounded-3xl shadow-sm border border-white overflow-hidden">
                        <div class="p-4 border-b border-white/50 flex items-center justify-between active:bg-white/50 cursor-pointer transition-colors">
                            <div class="flex items-center gap-3">
                                <div class="w-8 h-8 rounded-full bg-slate-100/50 flex items-center justify-center text-slate-500"><i class="fas fa-user-edit text-xs"></i></div>
                                <span class="text-sm font-bold text-slate-700">プロフィール編集</span>
                            </div>
                            <i class="fas fa-chevron-right text-slate-300 text-xs"></i>
                        </div>
                        <div class="p-4 border-b border-white/50 flex items-center justify-between active:bg-white/50 cursor-pointer transition-colors">
                            <div class="flex items-center gap-3">
                                <div class="w-8 h-8 rounded-full bg-slate-100/50 flex items-center justify-center text-slate-500"><i class="fas fa-bell text-xs"></i></div>
                                <span class="text-sm font-bold text-slate-700">通知設定</span>
                            </div>
                            <i class="fas fa-chevron-right text-slate-300 text-xs"></i>
                        </div>
                        <div class="p-4 flex items-center justify-between active:bg-red-50/50 cursor-pointer transition-colors">
                            <div class="flex items-center gap-3">
                                <div class="w-8 h-8 rounded-full bg-red-50 flex items-center justify-center text-red-500"><i class="fas fa-sign-out-alt text-xs"></i></div>
                                <span class="text-sm font-bold text-red-600">ログアウト</span>
                            </div>
                            <i class="fas fa-chevron-right text-slate-300 text-xs"></i>
                        </div>
                    </div>


                    <!-- 利用履歴 -->
                    <div>
                        <h3 class="font-bold text-md mb-3 text-slate-800">利用履歴</h3>`;
                       
                if (logs.length > 0) {
                    [...logs].reverse().forEach(log => {
                        html += `
                        <div class="bg-white/80 backdrop-blur-sm p-4 rounded-2xl shadow-sm border border-white flex items-center gap-4 mb-3">
                            <div class="w-10 h-10 bg-emerald-50 text-emerald-500 rounded-full flex items-center justify-center shrink-0 border border-emerald-100">
                                <i class="fas fa-check"></i>
                            </div>
                            <div class="flex-1 min-w-0">
                                <p class="font-bold text-xs truncate text-slate-800">${log.storeName}</p>
                                <p class="text-[10px] text-slate-500 truncate mt-0.5">${log.couponTitle}</p>
                                <p class="text-[9px] text-slate-400 mt-1 font-medium">${log.time}</p>
                            </div>
                            <div class="text-right">
                                <span class="text-[9px] text-slate-400 font-bold block mb-0.5">利用額</span>
                                <p class="text-sm font-black text-indigo-600">¥${log.spend.toLocaleString()}</p>
                            </div>
                        </div>`;
                    });
                } else {
                    html += `<div class="text-center py-10 bg-white/60 backdrop-blur-sm rounded-2xl border border-white shadow-sm mt-2">
                        <div class="w-12 h-12 bg-white/50 rounded-full flex items-center justify-center mx-auto mb-3">
                            <i class="fas fa-history text-slate-300 text-xl"></i>
                        </div>
                        <p class="text-xs text-slate-500 font-bold">履歴はありません</p>
                    </div>`;
                }
               
                html += `
                    </div>
                   
                    <div class="text-center pb-4 pt-2">
                        <p class="text-[10px] text-slate-400 font-bold">登録日: ${userProfile.memberSince}</p>
                        <p class="text-[10px] text-slate-300 mt-1">電子クーポン App v1.0</p>
                    </div>
                </div>`;
            }


            container.innerHTML = html;
        }


        function openCoupon(id) {
            selectedCoupon = coupons.find(c => c.id === id);
            useStep = 1;
            spendAmount = '';
            showModal();
        }


        function showModal() {
            const overlay = document.getElementById('modal-overlay');
            overlay.classList.remove('hidden');
            renderModalContent();
        }


        function renderModalContent(isSuccess = false) {
            const body = document.getElementById('modal-body');
           
            if (isSuccess) {
                body.innerHTML = `
                <div class="py-12 text-center">
                    <div class="w-20 h-20 bg-emerald-100 text-emerald-600 rounded-full flex items-center justify-center mx-auto mb-6 shadow-inner">
                        <i class="fas fa-check text-4xl"></i>
                    </div>
                    <h3 class="text-2xl font-black text-slate-800 mb-2">利用完了！</h3>
                    <p class="text-slate-500 text-sm font-medium">ご協力ありがとうございました。</p>
                </div>`;
                setTimeout(() => {
                    closeModal();
                    switchTab('account');
                }, 2000);
                return;
            }


            // QRコードの画像URLを生成
            const qrData = encodeURIComponent('coupon:' + selectedCoupon.id);
            const qrUrl = 'https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=' + qrData;


            body.innerHTML = `
                <div class="flex justify-between items-start mb-6">
                    <div>
                        <span class="text-[10px] font-bold text-indigo-600 bg-indigo-50 px-2 py-1 rounded-full uppercase tracking-widest inline-block mb-2">${selectedCoupon.storeName}</span>
                        <h3 class="text-xl font-black text-slate-800 leading-tight">${selectedCoupon.title}</h3>
                    </div>
                    <button onclick="closeModal()" class="w-8 h-8 flex items-center justify-center bg-slate-100 hover:bg-slate-200 rounded-full text-slate-500 transition-colors shrink-0"><i class="fas fa-times"></i></button>
                </div>
                <div class="bg-slate-50 border border-slate-100 rounded-2xl p-5 mb-6 text-xs text-slate-600 leading-relaxed font-medium">
                    ${selectedCoupon.desc}
                </div>
               
                <div class="flex justify-center mb-8">
                    <div class="bg-white p-2 rounded-xl border border-slate-200 shadow-sm">
                        <img src="${qrUrl}" alt="Coupon QR Code" class="w-32 h-32 object-contain mx-auto">
                        <p class="text-[8px] text-center text-slate-400 mt-2 uppercase tracking-widest">ID: ${selectedCoupon.id}</p>
                    </div>
                </div>


                <div id="modal-inputs" class="space-y-6">
                    ${renderStepContent()}
                </div>
                <div id="error-msg" class="hidden mt-4 bg-red-50 border border-red-100 text-red-600 text-xs font-bold p-4 rounded-xl flex items-center gap-2">
                    <i class="fas fa-exclamation-circle text-lg"></i> <span id="error-text"></span>
                </div>
                <button onclick="handleAction()" class="w-full bg-indigo-600 text-white py-4 rounded-2xl font-bold text-lg shadow-[0_4px_14px_0_rgba(79,70,229,0.39)] hover:shadow-[0_6px_20px_rgba(79,70,229,0.23)] mt-8 active:scale-95 transition-all">
                    ${useStep === 1 ? '次へ進む' : 'クーポンを確定する'}
                </button>
            `;
        }


        function renderStepContent() {
            if (useStep === 1) {
                return `
                <div>
                    <label class="block text-[10px] font-bold text-slate-500 uppercase mb-3">利用した合計金額 (税込)</label>
                    <div class="relative">
                        <span class="absolute left-5 top-1/2 -translate-y-1/2 text-slate-400 font-black text-xl">¥</span>
                        <input type="number" id="input-spend" placeholder="0" value="${spendAmount}" class="w-full bg-slate-100 border-2 border-transparent focus:border-indigo-400 rounded-2xl py-4 pl-12 pr-4 text-2xl font-black text-slate-800 outline-none transition">
                    </div>
                </div>`;
            } else {
                return `
                <div class="animate-in fade-in">
                    <label class="block text-[10px] font-bold text-slate-500 uppercase mb-3 text-center">店舗認証 (4桁のPINを入力)</label>
                    <input type="password" id="input-pin" inputmode="numeric" maxlength="4" placeholder="••••" class="w-full bg-indigo-50/50 border-2 border-indigo-200 focus:border-indigo-500 rounded-2xl py-4 px-4 text-4xl font-black text-slate-800 text-center tracking-[0.5em] outline-none transition">
                    <div class="mt-3 bg-amber-50 border border-amber-100 p-3 rounded-xl flex items-start gap-2">
                        <i class="fas fa-info-circle text-amber-500 mt-0.5"></i>
                        <p class="text-[10px] text-amber-700 font-bold leading-tight">この画面をお店の方に提示し、PINコードを入力してもらってください。</p>
                    </div>
                </div>`;
            }
        }


        function handleAction() {
            const errorDiv = document.getElementById('error-msg');
            const errorText = document.getElementById('error-text');
            errorDiv.classList.add('hidden');


            if (useStep === 1) {
                spendAmount = document.getElementById('input-spend').value;
                if (!spendAmount || spendAmount <= 0) {
                    errorDiv.classList.remove('hidden');
                    errorText.innerText = '有効な金額を入力してください';
                    return;
                }
                useStep = 2;
                renderModalContent();
            } else {
                const pin = document.getElementById('input-pin').value;
                const store = stores.find(s => s.id === selectedCoupon.storeId);
               
                if (pin === store.pin) {
                    const newLog = {
                        id: 'LOG-' + Date.now(),
                        storeId: store.id,
                        storeName: store.name,
                        couponId: selectedCoupon.id,
                        couponTitle: selectedCoupon.title,
                        spend: Number(spendAmount),
                        time: new Date().toLocaleString('ja-JP')
                    };
                   
                    logs.push(newLog);
                    localStorage.setItem(KEYS.LOGS, JSON.stringify(logs));
                    localStorage.setItem(KEYS.TRIGGER, Date.now());
                   
                    renderModalContent(true);
                } else {
                    errorDiv.classList.remove('hidden');
                    errorText.innerText = 'PINコードが違います';
                }
            }
        }


        function closeModal() {
            document.getElementById('modal-overlay').classList.add('hidden');
            selectedCoupon = null;
        }


        window.onload = init;
    </script>
</body>
</html>
